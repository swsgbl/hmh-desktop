{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmh.dev/schemas/event-envelope.schema.json",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "sessionId", "runId", "seq", "occurredAt", "kind", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "occurredAt": { "type": "string", "pattern": "\\d{4}-\\d{2}-\\d{2}T" },
    "kind": {
      "enum": [
        "run.started",
        "plan.updated",
        "tool.started",
        "tool.completed",
        "approval.required",
        "verification.updated",
        "artifact.created",
        "run.completed",
        "run.failed"
      ]
    },
    "payload": { "type": "object" }
  }
}
