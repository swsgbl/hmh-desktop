# 桌面构建期 runtime 产物(bundle-runtime/bundle-fake-host 生成)——钉到绝对路径,
# 裸 `resources/` 会误伤 ohos 源码资源(entry/src/main/resources、AppScope/resources,
# 其 element/profile 曾因此游离在版本控制外,干净 clone 无法构建 HAP)
/apps/desktop/resources/
out/
release/
build/
*.log
.vite/
*.tsbuildinfo
.DS_Store
test-out.log

# 鸿蒙 E2E 工具与构建暂存(hilog 抓包等,含敏感风险,永不入库)
.hm-tmp/
apps/ohos/.hm-tmp/
.verify/
# 本机 DevEco 工具链 junction(机器特定软链,由棒次脚本自建)
apps/hvigor/
apps/hvigor-ohos-plugin/

# 私有开发文档提取物(用户文档全文,绝不入库)
docx-*.txt
hmh-doc-*/

