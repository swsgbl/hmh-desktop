{
  "name": "hmh-desktop",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "HMH Desktop — 本地优先的 HMH Cognitive Workbench。Windows 优先桌面壳;hmharness 是唯一 Agent/Cognitive Runtime,本仓库不实现第二份 agent loop / 工具权限判定 / 认知模型。",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-force-exit packages/contracts/src/__tests__/*.test.ts packages/host-adapter/src/__tests__/*.test.ts packages/cli-installer/src/__tests__/*.test.ts scripts/__tests__/artifact-verify.test.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "security-test": "node scripts/build-electron.mjs && node scripts/security-test.mjs",
    "package": "node scripts/package.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "install-verify": "node scripts/install-verify.mjs",
    "sbom": "node scripts/gen-sbom.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
